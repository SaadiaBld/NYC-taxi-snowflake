# Copier la clé privée sous include/airflow_rsa_key.p8 dans la racine Astro.
# Copier ensuite la connexion ci-dessous dans le .env de cette racine.
# Ne jamais versionner le fichier .env ni la clé privée.
#
# Remplacer ORGANISATION-COMPTE, le login, le warehouse et le rôle par les vôtres.
AIRFLOW_CONN_SNOWFLAKE_NYC_TAXI='{"conn_type":"snowflake","login":"AIRFLOW_SVC","extra":{"account":"ORGANISATION-COMPTE","warehouse":"NYC_TAXI_WH","database":"NYC_TAXI","schema":"RAW","role":"TRANSFORMER","private_key_file":"/usr/local/airflow/include/airflow_rsa_key.p8"}}'
